/* =========================================================
   2) BLOCKING TEST - PENCERE 1
   Bunu 1. SSMS/Azure Data Studio penceresinde çalıştır.
   Bu session lock tutacak.
   ========================================================= */

USE DBADashDemo;
GO

SELECT
    'BLOCKER SESSION BASLADI' AS Info,
    @@SPID AS BlockerSessionID,
    DB_NAME() AS DatabaseName,
    SYSDATETIME() AS StartTime;

BEGIN TRAN;

UPDATE dbo.AccountBalance
SET Balance = Balance + 100,
    LastUpdated = SYSDATETIME()
WHERE AccountID = 1;

WAITFOR DELAY '00:05:00';

ROLLBACK;

SELECT
    'BLOCKER SESSION BITTI' AS Info,
    @@SPID AS BlockerSessionID,
    SYSDATETIME() AS EndTime;
GO


/* =========================================================
   3) BLOCKING TEST - PENCERE 2
   Pencere 1 çalışırken bunu 2. pencerede çalıştır.
   Bu session bloklanacak.
   ========================================================= */

USE DBADashDemo;
GO

SELECT
    'BLOCKED SESSION BASLADI' AS Info,
    @@SPID AS BlockedSessionID,
    DB_NAME() AS DatabaseName,
    SYSDATETIME() AS StartTime;

UPDATE dbo.AccountBalance
SET Balance = Balance - 100,
    LastUpdated = SYSDATETIME()
WHERE AccountID = 1;

SELECT
    'BLOCKED SESSION BITTI' AS Info,
    @@SPID AS BlockedSessionID,
    SYSDATETIME() AS EndTime;
GO


/* =========================================================
   4) Canlı kontrol sorgusu
   Blocking testi çalışırken 3. pencerede çalıştır.
   SQL Server içinde o an bekleyen/blocklanan queryleri gösterir.
   ========================================================= */

SELECT
    r.session_id,
    r.status,
    r.command,
    DB_NAME(r.database_id) AS DatabaseName,
    r.wait_type,
    r.wait_time AS WaitTimeMs,
    r.wait_resource,
    r.blocking_session_id,
    r.cpu_time,
    r.total_elapsed_time AS DurationMs,
    s.login_name,
    s.host_name,
    s.program_name,
    SUBSTRING
    (
        t.text,
        (r.statement_start_offset / 2) + 1,
        (
            CASE r.statement_end_offset
                WHEN -1 THEN DATALENGTH(t.text)
                ELSE r.statement_end_offset
            END - r.statement_start_offset
        ) / 2 + 1
    ) AS CurrentStatement,
    t.text AS BatchText
FROM sys.dm_exec_requests r
JOIN sys.dm_exec_sessions s
    ON s.session_id = r.session_id
OUTER APPLY sys.dm_exec_sql_text(r.sql_handle) t
WHERE r.session_id <> @@SPID
ORDER BY
    r.wait_time DESC,
    r.total_elapsed_time DESC;
GO


