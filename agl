/* =========================================================
   6) IO / scan testi
   Uzun scan üretir.
   ========================================================= */

USE DBADashDemo;
GO

DECLARE @i int = 1;

WHILE @i <= 20
BEGIN
    EXEC dbo.usp_IOHeavyScan;
    SET @i += 1;
END;
GO


/* =========================================================
   7) Daha ağır scan / sort testi
   Running Queries tarafında yakalanması daha olası.
   ========================================================= */

USE DBADashDemo;
GO

SELECT TOP (500000)
    l.LogID,
    l.CreatedAt,
    l.Severity,
    CHECKSUM(l.Message) AS MessageChecksum,
    REPLICATE(CONVERT(varchar(20), l.Severity), 20) AS PaddingText
FROM dbo.AppLog l
CROSS JOIN dbo.Numbers n
WHERE n.n <= 5
ORDER BY
    CHECKSUM(l.Message, n.n)
OPTION (MAXDOP 1);
GO


