/* =========================================================
   10) SQL AGENT JOB FAILURE DEMO
   Express Edition'da SQL Server Agent olmadığı için çalışmayabilir.
   ========================================================= */

USE msdb;
GO

IF OBJECT_ID('msdb.dbo.sp_add_job') IS NOT NULL
BEGIN
    IF EXISTS
    (
        SELECT 1
        FROM msdb.dbo.sysjobs
        WHERE name = N'DBADash Demo - Failing Job'
    )
    BEGIN
        EXEC msdb.dbo.sp_delete_job
            @job_name = N'DBADash Demo - Failing Job';
    END;

    EXEC msdb.dbo.sp_add_job
        @job_name = N'DBADash Demo - Failing Job',
        @enabled = 1,
        @description = N'Intentional failing job for DBADash demo.';

    EXEC msdb.dbo.sp_add_jobstep
        @job_name = N'DBADash Demo - Failing Job',
        @step_name = N'Intentional failure',
        @subsystem = N'TSQL',
        @database_name = N'DBADashDemo',
        @command = N'THROW 51000, ''DBADash demo intentional job failure'', 1;';

    EXEC msdb.dbo.sp_add_jobserver
        @job_name = N'DBADash Demo - Failing Job';

    EXEC msdb.dbo.sp_start_job
        @job_name = N'DBADash Demo - Failing Job';
END
ELSE
BEGIN
    PRINT 'SQL Agent job procs not found. Bu bolum Express Edition veya Agent olmayan ortamda atlandi.';
END
GO


/* =========================================================
   11) BACKUP + DBCC CHECKDB DEMO
   Default backup path varsa oraya backup alır.
   Path bulunamazsa backup'ı atlar, CHECKDB yine çalışır.
   ========================================================= */

USE master;
GO

DECLARE
    @BackupDir nvarchar(4000),
    @BackupFile nvarchar(4000),
    @SQL nvarchar(max);

SELECT @BackupDir = CONVERT(nvarchar(4000), SERVERPROPERTY('InstanceDefaultBackupPath'));

IF @BackupDir IS NULL OR LTRIM(RTRIM(@BackupDir)) = N''
BEGIN
    PRINT 'Default backup path bulunamadi. Backup bolumu atlandi.';
END
ELSE
BEGIN
    IF RIGHT(@BackupDir, 1) NOT IN (N'\', N'/')
    BEGIN
        IF CHARINDEX(N'\', @BackupDir) > 0
            SET @BackupDir = @BackupDir + N'\';
        ELSE
            SET @BackupDir = @BackupDir + N'/';
    END;

    SET @BackupFile = @BackupDir + N'DBADashDemo.bak';

    SET @SQL = N'
        BACKUP DATABASE DBADashDemo
        TO DISK = N''' + REPLACE(@BackupFile, '''', '''''') + N'''
        WITH INIT, COMPRESSION, STATS = 10;
    ';

    EXEC sys.sp_executesql @SQL;
END
GO

DBCC CHECKDB('DBADashDemo') WITH NO_INFOMSGS, ALL_ERRORMSGS;
GO


