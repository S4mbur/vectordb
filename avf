/* =========================================================
   4) INSERT DEMO DATA
   ========================================================= */

DECLARE
    @CustomerCount int = 50000,
    @ProductCount int = 1000,
    @OrderCount int = 300000;

INSERT dbo.Customer(CustomerName, City, CreatedAt)
SELECT
    CONCAT(N'Customer ', n),
    CASE n % 6
        WHEN 0 THEN N'Istanbul'
        WHEN 1 THEN N'Ankara'
        WHEN 2 THEN N'Izmir'
        WHEN 3 THEN N'Bursa'
        WHEN 4 THEN N'Antalya'
        ELSE N'Kocaeli'
    END,
    DATEADD(DAY, -(n % 1000), SYSUTCDATETIME())
FROM dbo.Numbers
WHERE n <= @CustomerCount;

INSERT dbo.Product(ProductName, CategoryID, Price)
SELECT
    CONCAT(N'Product ', n),
    (n % 20) + 1,
    CONVERT(money, ((n % 500) + 10) * 1.0)
FROM dbo.Numbers
WHERE n <= @ProductCount;

INSERT dbo.SalesOrder(CustomerID, OrderDate, Status, Note)
SELECT
    ((n * 17) % @CustomerCount) + 1,
    DATEADD(MINUTE, -(n % 700000), SYSUTCDATETIME()),
    CASE n % 4
        WHEN 0 THEN 'N'
        WHEN 1 THEN 'S'
        WHEN 2 THEN 'C'
        ELSE 'R'
    END,
    CONCAT(N'Demo order ', n)
FROM dbo.Numbers
WHERE n <= @OrderCount;

INSERT dbo.SalesOrderLine(OrderID, ProductID, Qty, UnitPrice)
SELECT
    o.OrderID,
    x.ProductID,
    CONVERT(smallint, (ABS(CHECKSUM(o.OrderID, v.LineNo)) % 5) + 1),
    p.Price
FROM dbo.SalesOrder o
CROSS JOIN (VALUES(1),(2),(3)) AS v(LineNo)
CROSS APPLY
(
    SELECT CONVERT(int, ((o.OrderID * v.LineNo * 13) % @ProductCount) + 1) AS ProductID
) AS x
JOIN dbo.Product p
    ON p.ProductID = x.ProductID
OPTION (MAXDOP 1);

INSERT dbo.AppLog(CreatedAt, Severity, Message)
SELECT
    DATEADD(SECOND, -n, SYSUTCDATETIME()),
    CONVERT(tinyint, n % 5),
    CONCAT(
        N'Log message ', n, N' ',
        REPLICATE(N'x', 200),
        CASE WHEN n % 777 = 0 THEN N' needle_not_indexed' ELSE N'' END
    )
FROM dbo.Numbers
WHERE n <= 200000;
GO


/* =========================================================
   5) STORED PROCEDURES
   ========================================================= */

CREATE OR ALTER PROCEDURE dbo.usp_SlowSalesReport
    @City nvarchar(50) = N'Istanbul',
    @DaysBack int = 365,
    @DelaySeconds int = 8
AS
BEGIN
    SET NOCOUNT ON;

    SELECT TOP (50)
        c.City,
        c.CustomerID,
        COUNT_BIG(*) AS LineCount,
        SUM(l.LineTotal) AS TotalAmount
    FROM dbo.Customer c
    JOIN dbo.SalesOrder o
        ON o.CustomerID = c.CustomerID
    JOIN dbo.SalesOrderLine l
        ON l.OrderID = o.OrderID
    WHERE c.City = @City
      AND o.OrderDate >= DATEADD(DAY, -@DaysBack, SYSUTCDATETIME())
    GROUP BY c.City, c.CustomerID
    ORDER BY SUM(l.LineTotal) DESC
    OPTION (MAXDOP 1);

    DECLARE @Delay char(8) =
        CONVERT(char(8), DATEADD(SECOND, @DelaySeconds, CONVERT(time, '00:00:00')), 108);

    WAITFOR DELAY @Delay;
END;
GO

CREATE OR ALTER PROCEDURE dbo.usp_MissingIndexDemo
    @CustomerID int = 12345
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        o.CustomerID,
        COUNT_BIG(*) AS OrderLineCount,
        SUM(l.LineTotal) AS TotalAmount
    FROM dbo.SalesOrder o
    JOIN dbo.SalesOrderLine l
        ON l.OrderID = o.OrderID
    WHERE o.CustomerID = @CustomerID
      AND o.OrderDate >= DATEADD(DAY, -90, SYSUTCDATETIME())
    GROUP BY o.CustomerID
    OPTION (MAXDOP 1);
END;
GO

CREATE OR ALTER PROCEDURE dbo.usp_IOHeavyScan
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        Severity,
        COUNT_BIG(*) AS RowCount,
        SUM(DATALENGTH(Message)) AS TotalBytes
    FROM dbo.AppLog
    WHERE Message LIKE N'%needle_not_indexed%'
    GROUP BY Severity
    OPTION (MAXDOP 1);
END;
GO

CREATE OR ALTER PROCEDURE dbo.usp_CPULoad
    @Seconds int = 30
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE
        @StopAt datetime2(3) = DATEADD(SECOND, @Seconds, SYSDATETIME()),
        @i int = 0,
        @x varbinary(32) = 0x01020304;

    WHILE SYSDATETIME() < @StopAt
    BEGIN
        SET @x = HASHBYTES('SHA2_256', @x + CONVERT(varbinary(4), @i));
        SET @i += 1;
    END;

    SELECT @i AS Iterations, @x AS HashValue;
END;
GO

CREATE OR ALTER PROCEDURE dbo.usp_DemoWorkload
    @Iterations int = 20
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @i int = 1;

    WHILE @i <= @Iterations
    BEGIN
        EXEC dbo.usp_MissingIndexDemo @CustomerID = ((@i * 7919) % 50000) + 1;

        IF @i % 5 = 0
            EXEC dbo.usp_IOHeavyScan;

        IF @i % 10 = 0
            EXEC dbo.usp_SlowSalesReport
                @City = N'Istanbul',
                @DaysBack = 365,
                @DelaySeconds = 5;

        SET @i += 1;
    END;
END;
GO


