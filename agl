/* =========================================================
   7) Kontrol
   ========================================================= */

SELECT
    s.name AS SchemaName,
    p.name AS ProcedureName,
    p.create_date,
    p.modify_date
FROM sys.procedures p
JOIN sys.schemas s
    ON s.schema_id = p.schema_id
WHERE s.name = N'UserReport'
  AND p.name LIKE N'Burak_0[8-9]%'
   OR s.name = N'UserReport'
  AND p.name LIKE N'Burak_1[0-2]%'
ORDER BY p.name;
GO
