/* =========================================================
   Eski DBADash Custom Report Temizliği

   BUNU DBADash REPOSITORY DATABASE'DE ÇALIŞTIR.
   Monitored DBADashDemo içinde çalıştırma.

   Sadece USE kısmını kendi repository DB adına göre değiştir.
   ========================================================= */

USE [DBADashDB]; -- Burayı kendi DBA Dash repository DB adınla değiştir
GO

/* Eski deneme raporları */

IF OBJECT_ID(N'UserReport.DemoDatabaseInventory', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.DemoDatabaseInventory;
GO

IF OBJECT_ID(N'UserReport.SelectedDatabaseInfo', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.SelectedDatabaseInfo;
GO

IF OBJECT_ID(N'UserReport.Burak_Test_Instance_Report', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.Burak_Test_Instance_Report;
GO

IF OBJECT_ID(N'UserReport.Burak_Test_Database_Report', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.Burak_Test_Database_Report;
GO

IF OBJECT_ID(N'UserReport.Burak_CustomReport_Test', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.Burak_CustomReport_Test;
GO

IF OBJECT_ID(N'UserReport.Burak_DemoDB_Check', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.Burak_DemoDB_Check;
GO

IF OBJECT_ID(N'UserReport.Burak_Test_Report', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.Burak_Test_Report;
GO

IF OBJECT_ID(N'UserReport.Burak_DemoDB_Status', N'P') IS NOT NULL
    DROP PROCEDURE UserReport.Burak_DemoDB_Status;
GO


/* Kalan custom reportları kontrol et */

SELECT
    s.name AS SchemaName,
    p.name AS ProcedureName,
    p.create_date,
    p.modify_date
FROM sys.procedures p
JOIN sys.schemas s
    ON s.schema_id = p.schema_id
WHERE s.name = N'UserReport'
ORDER BY p.name;
GO
