CREATE OR ALTER PROCEDURE UserReport.DemoDatabaseInventory
(
    @InstanceIDs IDs READONLY,
    @DatabaseName sysname = N'DBADashDemo'
)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        I.ConnectionID,
        D.name AS DatabaseName,
        D.DatabaseID,
        D.InstanceID
    FROM dbo.Databases D
    JOIN dbo.Instances I
        ON D.InstanceID = I.InstanceID
    JOIN @InstanceIDs T
        ON T.ID = I.InstanceID
    WHERE
        @DatabaseName IS NULL
        OR D.name = @DatabaseName
    ORDER BY
        I.ConnectionID,
        D.name;
END;
GO

