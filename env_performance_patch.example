# PDF extraction
PDF_EXTRACTOR=pymupdf
PDF_TEXT_SORT=false
PDF_FALLBACK_TO_PYPDF=true

# 1 = safest. For large PDFs on Linux try 2 or 4.
PDF_EXTRACT_WORKERS=2
PDF_PARALLEL_MIN_PAGES=100

# Chunk structure remains unchanged
CHUNK_MAX_WORDS=450
CHUNK_OVERLAP_WORDS=80
CHUNK_MIN_WORDS=20

# Embedding throughput
# Start with 16/2. If stable, try 32/3 or 32/4.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=3
EMBEDDING_REQUEST_TIMEOUT=180
EMBEDDING_MAX_RETRIES=3
EMBEDDING_INITIAL_BACKOFF=1
EMBEDDING_MAX_BACKOFF=10

# Application
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=info
