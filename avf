CREATE OR ALTER PROCEDURE UserReport.Burak_Test_Instance_Report
(
    @InstanceIDs IDs READONLY
)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        I.InstanceID,
        I.ConnectionID,
        I.InstanceDisplayName,
        I.EngineEdition,
        I.Edition,
        I.ProductVersion,
        I.ProductLevel
    FROM dbo.Instances I
    JOIN @InstanceIDs T
        ON T.ID = I.InstanceID
